[Unit]
Description=PathAble database backup (pg_dump, custom format) and its verified copy in S3
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
# The scheduled backup has failed unless S3 holds a verified copy of it
# (backup.sh, offsite.py). A failure leaves this unit failed, which
# `systemctl --failed` and `journalctl -u pathable-backup.service` show.
Environment=PATHABLE_BACKUP_OFFSITE=required
ExecStart=/srv/pathable/repo/infra/vps/backup.sh scheduled
# After every run, failed or not, what Alloy reports about the backups
# (backup_metrics.py, docs/deployment/OBSERVABILITY.md). The "-": failing to
# write the status never changes the backup's own result, and a status that
# stops being written raises an alert of its own.
ExecStopPost=-/usr/bin/python3 /srv/pathable/repo/infra/vps/backup_metrics.py record-run
# A oneshot otherwise waits forever; uploads retry for a few minutes at most.
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
